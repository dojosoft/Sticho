{
  "name": "sticho",
  "private": true,
  "version": "0.1.0",
  "description": "Sticho - 轻量级 Markdown / 纯文本 / 代码 / HTML 文档编辑器",
  "license": "MIT",
  "author": "Marvin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dojosoft/sticho.git"
  },
  "homepage": "https://github.com/dojosoft/sticho#readme",
  "bugs": {
    "url": "https://github.com/dojosoft/sticho/issues"
  },
  "keywords": [
    "markdown",
    "editor",
    "notepad",
    "html",
    "code-editor",
    "offline",
    "tauri",
    "svelte",
    "windows"
  ],
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-vditor-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-vditor-assets.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check-version": "node scripts/check-version.mjs",
    "i18n-missing": "node scripts/i18n-missing.mjs",
    "release": "node scripts/release.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-store": "^2.4.5",
    "docx": "^9.7.1",
    "markdown-it": "^14.3.2",
    "pdfjs-dist": "^4.10.38",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "vditor": "3.11.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tauri-apps/cli": "^2.1.0",
    "@types/markdown-it": "^14.2.0",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.16.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.5",
    "vitest": "^5.0.3"
  }
}
