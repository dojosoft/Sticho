# Node
node_modules/
# vite 的构建产物：只忽略仓库根这一份，必须带前导斜杠——
# 写成 `dist/` 会连带忽略 public/vditor/dist 这类嵌套目录（曾经因此漏掉 12MB 运行资源）
/dist/
*.local

# Rust / Tauri
src-tauri/target/
src-tauri/Cargo.lock.bak
src-tauri/gen/schemas/

# 打包产物（安装包 / 绿色版，体积大且可重建）
release/

# 运行时用户数据（可能落在仓库内：绿色版把配置写到 <exe>\Sticho）
# 其中 secrets.json 含 DPAPI 加密的 WebDAV 密码，data-location.json 是位置标记
Sticho/
secrets.json
data-location.json

# 密钥与证书（签名私钥、证书，绝不入库）
*.pem
*.key
*.pfx
*.p12
.env
.env.*

# 日志
*.log
npm-debug.log*

# 编辑器
.vscode/
.idea/
*.swp

# 系统文件
.DS_Store
Thumbs.db

# 本地工具目录（审查草稿、规格草稿、截图等）与临时的导入演示文件
.trae/
demo.docx
demo.pdf

# Vditor 运行时资源（公式 / 图表 / 代码高亮配色 / 表情图片等，约 12MB）：
# 由 scripts/sync-vditor-assets.mjs 在 predev / prebuild 时从 node_modules/vditor 同步，不入库
/public/vditor/
